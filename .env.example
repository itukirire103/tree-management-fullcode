# ローカル開発用。実際の値は .env にコピーして設定する(.envはgit管理しない)。

# --- Database ---
POSTGRES_USER=treeapp
POSTGRES_PASSWORD=changeme
POSTGRES_DB=tree_management
DATABASE_URL=postgresql://treeapp:changeme@localhost:5432/tree_management

# --- API ---
PORT=3001
JWT_ACCESS_SECRET=changeme-access-secret
JWT_REFRESH_SECRET=changeme-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- File storage ---
# local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# S3互換(本番: Cloudflare R2等)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:3001
