# ローカル開発用。実際の値は .env にコピーして設定する(.envはgit管理しない)。

# --- Database (Neon) ---
# DATABASE_URL: アプリの実行時クエリ用。Neonのプール接続(ホスト名に-poolerが付く)を使う。
# DIRECT_DATABASE_URL: prisma migrate等のマイグレーション専用。プールを経由しない直接接続。
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DIRECT_DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# --- API ---
# production: 同一オリジンでAPI+SPAを配信するためCORS_ORIGINは未使用になる
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
PORT=3001
JWT_ACCESS_SECRET=changeme-access-secret
JWT_REFRESH_SECRET=changeme-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- File storage ---
# local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# S3互換(本番: Cloudflare R2等)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:3001
